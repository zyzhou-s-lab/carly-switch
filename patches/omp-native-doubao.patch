+import { describe, expect, test } from "bun:test";
+import { Settings } from "../../src/config/settings";
+import { LiveSessionController, type LiveTranscript } from "../../src/live/controller";
+import { DoubaoProtocol } from "../../src/live/doubao-protocol";
+import { parseLiveServerEvent, type LiveServerEvent } from "../../src/live/protocol";
+import type { LiveTransportCallbacks } from "../../src/live/transport";
+import type { AgentSession } from "../../src/session/agent-session";
+
+async function transcriptSession(provider: "codex" | "doubao" = "doubao") {
+	const transcripts: LiveTranscript[] = [];
+	const failures: Error[] = [];
+	let callbacks!: LiveTransportCallbacks;
+	const session = {
+		settings: Settings.isolated({ "live.provider": provider }),
+		modelRegistry: { authStorage: {} },
+		sessionId: "transcript-regression",
+		subscribe: () => () => {},
+	} as unknown as AgentSession;
+	const controller = new LiveSessionController({
+		session,
+		extractAssistantText: () => "",
+		callbacks: {
+			onPhase() {},
+			onLevels() {},
+			onTranscript(transcript) {
+				if (transcript) transcripts.push(transcript);
+			},
+			onTerminal(error) {
+				if (error) failures.push(error);
+			},
+		},
+	}, {
+		createTransport(options) {
+			callbacks = options.callbacks;
+			return {
+				async connect() {},
+				pushAudio() {},
+				async setMuted() {},
+				async send() {},
+				async close() {},
+			};
+		},
+		createCapture: () => ({ stop() {} }),
+	});
+	await controller.start();
+	const protocol = new DoubaoProtocol("system", "transcript-regression");
+	return {
+		controller,
+		transcripts,
+		failures,
+		feed(payload: unknown) {
+			for (const event of protocol.handle(payload).events) callbacks.onEvent(event);
+		},
+		emit(event: LiveServerEvent) {
+			callbacks.onEvent(event);
+		},
+	};
+}
+
+describe("live controller transcripts", () => {
+	test("replaces cumulative ASR punctuation and middle-word revisions while streaming, including identical next turns", async () => {
+		const f = await transcriptSession();
+		const revisions = [
+			"帮我把标签页改名豆包语音验证",
+			"帮我把标签页，改名豆包语音验证",
+			"帮我把当前标签页，改名豆包语音验证",
+		];
+		const final = "把标签页改名豆包语音验证。";
+		try {
+			for (let turn = 1; turn <= 2; turn++) {
+				f.feed({ type: "conversation.item.input_audio_transcription.started" });
+				for (const text of revisions) {
+					f.feed({ type: "conversation.item.input_audio_transcription.delta", delta: text });
+					expect(f.transcripts.at(-1)).toEqual({ role: "user", turn, text, final: false });
+				}
+				f.feed({ type: "conversation.item.input_audio_transcription.completed", text: final });
+				expect(f.transcripts.at(-1)).toEqual({ role: "user", turn, text: final, final: true });
+			}
+			expect(f.transcripts).toHaveLength(8);
+			expect(f.failures).toEqual([]);
+		} finally {
+			await f.controller.stop();
+		}
+	});
