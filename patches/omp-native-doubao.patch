+				if (responseId ?? this.#responseId) this.#canceledResponses.add((responseId ?? this.#responseId)!);
+				if (!responseId || responseId === this.#responseId) {
+					this.#blockUnidentifiedAudio = true;
+					if (this.#outputText) this.#outputTurn++;
+					this.#outputText = "";
+					update.stopAudio = true;
+				}
+				break;
+			case "conversation.item.input_audio_transcription.delta":
+				if (typeof event.delta === "string") {
+					this.#inputText = event.delta;
+					update.events.push({ type: "input_transcript.added", item: { text: this.#inputText, turnId: `doubao-user-${this.#inputTurn}`, snapshot: true } });
+				}
+				break;
+			case "conversation.item.input_audio_transcription.completed":
+				update.events.push({ type: "turn.done", turn: { role: "user", transcript: typeof event.text === "string" ? event.text : this.#inputText, turnId: `doubao-user-${this.#inputTurn++}`, snapshot: true } });
+				this.#inputText = "";
+				break;
+			case "response.output_text.delta":
+				if (!canceled && typeof event.delta === "string") {
+					this.#outputText += event.delta;
+					update.events.push({ type: "output_transcript.added", item: { text: this.#outputText, turnId: `doubao-assistant-${this.#outputTurn}`, snapshot: true } });
+				}
+				break;
+			case "response.output_text.done":
+				if (!canceled) {
+					update.events.push({ type: "turn.done", turn: { role: "assistant", transcript: typeof event.text === "string" ? event.text : this.#outputText, turnId: `doubao-assistant-${this.#outputTurn++}`, snapshot: true } });
+					this.#outputText = "";
+				}
+				break;
+			case "response.output_audio.delta":
+				if (!canceled && typeof event.delta === "string") update.audio = event.delta;
+				break;
+			case "response.output_audio.done":
+				if (!canceled) update.endAudio = true;
+				break;
+			case "response.done":
+				if (!canceled) update.endAudio = true;
+				break;
+			case "response.function_call_arguments.done": {
+				const calls: FunctionCall[] = [];
+				const invalidCalls: { id: string }[] = [];
+				for (const raw of Array.isArray(event.items) ? event.items : []) {
+					const item = record(raw);
+					if (!item || typeof item.call_id !== "string" || this.#seenCalls.has(item.call_id)) continue;
+					this.#seenCalls.add(item.call_id);
+					let args: WireMessage | undefined;
+					try { args = typeof item.arguments === "string" ? record(JSON.parse(item.arguments)) : undefined; } catch { /* Invalid calls receive a paired error result. */ }
+					if (item.name !== "delegate_to_omp" || typeof args?.task !== "string" || !args.task.trim()) {
+						invalidCalls.push({ id: item.call_id });
+						continue;
+					}
+					calls.push({ id: item.call_id, task: args.task });
+				}
+				if (invalidCalls.length) update.messages.push(toolResults(invalidCalls,
+					"Cannot execute tool call: expected delegate_to_omp with a nonempty task string."));
+				if (calls.length) {
+					if (this.#active) {
+						update.messages.push(toolResults(this.#active.calls,
+							"Superseded by a newer user request before completion. This is not a successful result; the backend agent is being steered to the newer request."));
+					}
+					this.#active = { id: calls[0]!.id, calls, chunks: [] };
+					this.#progress = "";
+					update.messages.push(this.#instructionsUpdate());
+					const task = calls.length === 1 ? calls[0]!.task :
+						`Execute ALL of these requests in the current agent turn. In the final answer, label each request's actual outcome with its call_id; do not omit any request or claim unperformed work succeeded.\n${calls.map(call => `[call_id: ${call.id}]\n${call.task}`).join("\n\n")}`;
+					update.events.push({ type: "delegation.created", item: {
+						type: "delegation", target: "client", id: this.#active.id,
+						content: [{ type: "input_text", text: task }],
+					} });
+				}
+				break;
+			}
+			case "error":
+				// Server error strings may echo request headers. Do not forward them.
+				update.events.push({ type: "error", message: "Doubao live server reported an error" });
+				break;
+		}
+		return update;
+	}
+}
