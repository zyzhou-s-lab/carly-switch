+class TestSocket extends EventTarget {
+	readyState = 0;
+	bufferedAmount = 0;
+	binaryType = "";
+	messages: Record<string, unknown>[] = [];
+	terminated = false;
+	autoCloseAck = true;
+	open(): void { this.readyState = 1; this.dispatchEvent(new Event("open")); }
+	receive(message: object): void { this.dispatchEvent(new MessageEvent("message", { data: JSON.stringify(message) })); }
+	send(data: string): void {
+		const message = JSON.parse(data);
+		this.messages.push(message);
+		if (message.type === "session.close" && this.autoCloseAck) this.receive({ type: "session.closed" });
+	}
+	close(): void { this.readyState = 3; this.dispatchEvent(new Event("close")); }
+	terminate(): void { this.terminated = true; this.readyState = 3; }
