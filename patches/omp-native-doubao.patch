+import type { LiveClientMessage, LiveServerEvent } from "./protocol";
+
+export const DOUBAO_LIVE_URL = "wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue";
+export const DOUBAO_INPUT_RATE = 16_000;
+export const DOUBAO_OUTPUT_RATE = 24_000;
+export const DOUBAO_FRAME_SAMPLES = 320;
+
+type WireMessage = Record<string, unknown>;
+interface FunctionCall { id: string; task: string }
+interface DelegationBatch { id: string; calls: FunctionCall[]; chunks: string[] }
+export interface DoubaoUpdate {
+	events: LiveServerEvent[];
+	messages: WireMessage[];
+	audio?: string;
+	stopAudio?: boolean;
+	endAudio?: boolean;
+	created?: boolean;
+}
+
+export function doubaoSession(instructions: string, voice: string): WireMessage {
+	return {
+		model: "1.2.6.1", instructions,
+		audio: {
+			input: { format: { type: "pcm", rate: DOUBAO_INPUT_RATE } },
+			output: { format: { type: "pcm_s16le", rate: DOUBAO_OUTPUT_RATE }, voice },
+		},
+		tools: [{
+			type: "function", name: "delegate_to_omp",
+			description: "Delegate work requiring tools, files, coding, or research to the current OMP agent session. Its final tool result is the backend final answer. Commentary is silent progress, never recited.",
+			parameters: { type: "object", properties: { task: { type: "string" } }, required: ["task"] },
+		}],
+	};
+}
+
+export function decodeDoubaoAudio(base64: string): Float32Array {
+	const bytes = Buffer.from(base64, "base64");
+	if (bytes.length % 2 !== 0) throw new Error("Doubao returned an incomplete PCM sample");
+	const samples = new Float32Array(bytes.length / 2);
+	for (let i = 0; i < samples.length; i++) samples[i] = bytes.readInt16LE(i * 2) / 32768;
+	return samples;
+}
+
+/** Fixed-size ring: keep the newest 200 ms instead of growing capture latency. */
+export class DoubaoInputBuffer {
+	readonly #samples = new Float32Array(DOUBAO_FRAME_SAMPLES * 10);
+	readonly #frame = Buffer.alloc(DOUBAO_FRAME_SAMPLES * 2);
+	#head = 0;
+	#size = 0;
+	clear(): void { this.#head = 0; this.#size = 0; }
+	push(samples: Float32Array): void {
+		for (const sample of samples) {
+			if (this.#size === this.#samples.length) {
+				this.#head = (this.#head + 1) % this.#samples.length;
+				this.#size--;
+			}
+			this.#samples[(this.#head + this.#size++) % this.#samples.length] = sample;
+		}
+	}
+	frame(): string {
+		for (let i = 0; i < DOUBAO_FRAME_SAMPLES; i++) {
+			let sample = 0;
+			if (this.#size > 0) {
+				sample = this.#samples[this.#head]!;
+				this.#head = (this.#head + 1) % this.#samples.length;
+				this.#size--;
+			}
+			const value = Number.isFinite(sample) ? Math.max(-1, Math.min(1, sample)) : 0;
+			this.#frame.writeInt16LE(Math.round(value * (value < 0 ? 32768 : 32767)), i * 2);
+		}
+		return this.#frame.toString("base64");
+	}
+}
+
+function record(value: unknown): WireMessage | undefined {
+	return typeof value === "object" && value !== null && !Array.isArray(value) ? value as WireMessage : undefined;
+}
+function toolResults(calls: readonly { id: string }[], text: string): WireMessage {
+	return { type: "conversation.item.create", items: calls.map(call => ({
+		call_id: call.id, role: "tool", content: [{ type: "input_text", text }],
+	})) };
+}
+
+/** Stateful translation, independent of sockets and the native audio device. */
+export class DoubaoProtocol {
+	readonly #instructions: string;
+	readonly #sessionId: string;
