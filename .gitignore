# Track only plugin sources, documentation, and the reviewed native patch.
# Binaries, credentials, archives, local state, and generated output stay excluded.
/*
!/.gitignore
!/README.md
!/LICENSE
!/plugin.toml
!/host.luau
!/window.luau
!/panel.css
!/helper.mjs
!/runtime-build.mjs
!/runtime-build.test.mjs
!/patches/
/patches/*
!/patches/omp-native-doubao.patch
